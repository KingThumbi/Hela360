# Hela360 local development environment example.
#
# Copy this file to .env and provide environment-specific values.
# Never commit production or personal secrets.

SECRET_KEY=replace-with-a-secure-random-secret
JWT_SECRET_KEY=replace-with-a-secure-random-jwt-secret

JWT_ALGORITHM=HS256
JWT_ISSUER=hela360
JWT_AUDIENCE=hela360-api

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hela360

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
